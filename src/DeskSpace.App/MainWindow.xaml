<Window x:Class="DeskSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskSpace.App.ViewModels"
        xmlns:views="clr-namespace:DeskSpace.App.Views"
        Title="DeskSpace" Height="760" Width="1180" MinHeight="520" MinWidth="900"
        Background="#F5F6F8" WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 布局视图解析：CurrentView 绑定到对应视图模型时渲染对应视图 -->
        <DataTemplate DataType="{x:Type vm:CategoryNavViewModel}">
            <views:CategoryNavView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FreePanelsViewModel}">
            <views:FreePanelsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：软件名 + 布局切换 + 添加 + 刷新 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DeskSpace" FontSize="20" FontWeight="SemiBold" Foreground="#1B1F24" />
                <TextBlock Text="桌面工作空间 · 分类导航 / 自由分区共用同一份数据"
                           FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="添加项目" Padding="14,7" Margin="0,0,8,0" FontSize="13"
                        ToolTip="通过文件选择器添加程序、快捷方式、文件夹或普通文件"
                        Command="{Binding AddCustomCommand}" />
                <Button Content="悬浮窗" Padding="14,7" Margin="0,0,8,0" FontSize="13"
                        ToolTip="切换到悬浮窗快速启动（数据共用）"
                        Command="{Binding SwitchToFloatingCommand}" />
                <Button Content="侧边栏" Padding="14,7" Margin="0,0,8,0" FontSize="13"
                        ToolTip="切换到侧边栏快捷入口（数据共用）"
                        Command="{Binding SwitchToSidebarCommand}" />
                <Button Content="{Binding LayoutToggleText}" Padding="14,7" Margin="0,0,8,0" FontSize="13"
                        Command="{Binding ToggleLayoutCommand}" />
                <Button Content="刷新" Padding="14,7" Margin="0,0,8,0" FontSize="13"
                        Command="{Binding RefreshCommand}" />
                <Button Content="托盘" Padding="14,7" FontSize="13"
                        ToolTip="最小化到系统托盘（应用继续运行，可从托盘退出）"
                        Click="OnMinimizeToTray" />
            </StackPanel>
        </Grid>

        <!-- 搜索框 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="12,9" />
            <TextBlock Text="搜索桌面项目（不区分大小写，切换布局不丢失）…"
                       Foreground="#9CA3AF" FontSize="14"
                       Margin="15,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 扫描/配置警告条 -->
        <Border Grid.Row="2" Background="#FFF4E5" BorderBrush="#F5C97B" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding WarningText}" Foreground="#8A5A00"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,28,0" />
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="#8A5A00" ToolTip="忽略此提示"
                        Command="{Binding DismissWarningCommand}" />
            </Grid>
        </Border>

        <!-- 内容区：布局视图（分类导航 / 自由分区） + 加载中 + 空状态 -->
        <Grid Grid.Row="3">
            <ContentControl Content="{Binding CurrentView}"
                            Visibility="{Binding IsNotLoading, Converter={StaticResource BoolToVis}}" />

            <!-- 加载状态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                <TextBlock Text="正在扫描桌面…" Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="13" Foreground="#6B7280" />
            </StackPanel>

            <!-- 全局空状态（桌面完全为空且无搜索） -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EmptyStateText}" FontSize="14" Foreground="#6B7280"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <!-- 状态栏：项目统计 + 自动同步状态 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#6B7280"
                       FontSize="12" HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            <TextBlock Text="{Binding SyncStatusText}" FontSize="12"
                       HorizontalAlignment="Right" ToolTip="{Binding SyncStatusDetail}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#6B7280" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSyncWarning}" Value="True">
                                <Setter Property="Foreground" Value="#B45309" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
