<?xml version="1.0" encoding="utf-8"?>
<!--
  DeskSpace 发布配置：自包含单文件版（Self-contained）

  用法：
    dotnet publish src/DeskSpace.App/DeskSpace.App.csproj -c Release -p:PublishProfile=win-x64-selfcontained

  与 win-x64-singlefile.pubxml 的区别（两条路径互不干扰，各自独立目录）：

    SelfContained     : false（依赖目标机运行时）        / true（自带运行时）
    体积              : 约 0.5 MB                        / 约 80~100 MB
    目标机要求        : 必须装 .NET 10 桌面运行时        / 无要求，开箱即用
    输出目录          : publish\win-x64                  / publish\win-x64-selfcontained

  结论性设置：
    RuntimeIdentifier=win-x64              仅 64 位 Windows
    SelfContained=true                     把 .NET 运行时与 WPF 一起打进 exe
    PublishSingleFile=true                 仍然是单文件 exe（启动时解压到 %TEMP%\.net 下）
    IncludeNativeLibrariesForSelfExtract   WPF 有原生组件（wpfgfx 等），必须允许解压；
                                           设为 false 会导致启动失败
    PublishTrimmed=false                   不裁剪：WPF 反射与 COM 互操作多，裁剪风险高于收益
    PublishReadyToRun=false                不启用 R2R：体积优先（自包含本身体积已经很大）
    DebugType=embedded                     符号嵌进程序集，发布目录不出现 .pdb
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishDir>..\..\publish\win-x64-selfcontained\</PublishDir>
  </PropertyGroup>
</Project>
