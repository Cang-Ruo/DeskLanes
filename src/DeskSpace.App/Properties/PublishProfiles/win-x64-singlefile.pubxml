<?xml version="1.0" encoding="utf-8"?>
<!--
  DeskSpace 发布配置（阶段 7 审查后固化，此前发布参数只存在于命令行、无法复现）。

  用法：
    dotnet publish src/DeskSpace.App/DeskSpace.App.csproj -c Release -p:PublishProfile=win-x64-singlefile

  结论性设置：
    - RuntimeIdentifier=win-x64      仅 64 位 Windows
    - SelfContained=false            依赖目标机器安装 .NET 10 Desktop Runtime（WPF 必需 WindowsDesktop 框架）
    - PublishSingleFile=true         单文件便携 exe
    - PublishReadyToRun=false        不启用 R2R（体积优先，启动速度已足够）
    - PublishTrimmed=false           不启用裁剪（反射/COM 互操作多，裁剪风险高）
    - DebugType=none                 发布产物不带 pdb（此前 publish 目录会带两个 pdb）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      embedded：把调试符号嵌进程序集，不额外产出 .pdb 文件。
      发布目录只留一个 exe，同时保留异常堆栈里的行号（errors.log 排错需要）。
    -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
