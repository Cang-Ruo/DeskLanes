<Window x:Class="DeskSpace.App.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskSpace.App.ViewModels"
        xmlns:local="clr-namespace:DeskSpace.App.Views"
        Title="DeskSpace 快速启动"
        Width="620" Height="520" MinWidth="420" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12"
            BorderBrush="#D7DCE3" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#1B1F24" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：搜索框 + 模式切换 + 关闭 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Padding="12,10"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="搜索桌面项目（不区分大小写）…"
                           Foreground="#9CA3AF" FontSize="14" Margin="16,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="全屏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="切换到全屏工作空间（数据共用）"
                            Command="{Binding ToggleFullModeCommand}" />
                    <Button Content="侧边栏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="切换到侧边栏模式（数据共用）"
                            Command="{Binding ToggleSidebarModeCommand}" />
                    <Button Content="✕" Width="28" Height="24" Padding="0" Background="Transparent"
                            BorderThickness="0" Foreground="#6B7280" ToolTip="隐藏窗口（Esc）"
                            Command="{Binding HideWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 分类标签 -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,8">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Margin" Value="0,0,6,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" CornerRadius="14" Padding="10,4">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="#9CA3AF"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 项目网格：双击 / 回车启动 -->
            <ListBox Grid.Row="2"
                     x:Name="ItemList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" CornerRadius="8">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:ItemTile />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding OpenItemCommand}"
                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <KeyBinding Key="Enter"
                                Command="{Binding OpenItemCommand}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
            </ListBox>

            <!-- 空状态 -->
            <TextBlock Grid.Row="2" Text="{Binding EmptyStateText}" FontSize="13"
                       Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />

            <!-- 底部状态栏 -->
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="#6B7280"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
