<Window x:Class="DeskSpace.App.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskSpace.App.ViewModels"
        xmlns:local="clr-namespace:DeskSpace.App.Views"
        Title="DeskSpace 侧边栏"
        Width="280" Height="760" MinWidth="44" MinHeight="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="#FFFFFFFF" Padding="10" BorderBrush="#D7DCE3">
        <!-- 圆角与边框方向随停靠侧自适应：左侧停靠圆左边、无右边框；右侧停靠镜像 -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12,0,0,12" />
                <Setter Property="BorderThickness" Value="1,1,0,1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDockedRight}" Value="True">
                        <Setter Property="CornerRadius" Value="0,12,12,0" />
                        <Setter Property="BorderThickness" Value="1,1,1,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#1B1F24" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部：展开/收起 + 停靠切换 + 模式 + 关闭 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{Binding ExpandToggleText}" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                        ToolTip="展开 / 收起侧边栏"
                        Command="{Binding ToggleExpandedCommand}" />
                <Button Content="{Binding DockToggleText}" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                        ToolTip="切换停靠到屏幕左侧或右侧"
                        Command="{Binding ToggleDockCommand}" />
                <Button Content="全屏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                        ToolTip="切换到全屏工作空间（数据共用）"
                        Command="{Binding ToggleFullModeCommand}" />
                <Button Content="悬浮" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                        ToolTip="切换到悬浮窗（数据共用）"
                        Command="{Binding ToggleFloatingModeCommand}" />
                <Button Content="✕" Width="26" Height="24" Padding="0" Background="Transparent"
                        BorderThickness="0" Foreground="#6B7280" HorizontalAlignment="Right"
                        ToolTip="隐藏侧边栏（不退出应用）"
                        Command="{Binding HideWindowCommand}" />
            </StackPanel>

            <!-- 展开状态：分类 + 项目 -->
            <Grid Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="分类" FontSize="12" FontWeight="SemiBold"
                           Foreground="#6B7280" Margin="0,0,0,4" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0" MaxHeight="150"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,0,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ItemCount}" FontSize="10" Foreground="#9CA3AF"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Items}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" CornerRadius="6" ToolTip="{Binding TooltipText}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" MaxWidth="200" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding OpenItemCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <KeyBinding Key="Enter"
                                    Command="{Binding OpenItemCommand}"
                                    CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </ListBox.InputBindings>
                </ListBox>

                <TextBlock Grid.Row="2" Text="{Binding EmptyStateText}" FontSize="12"
                           Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="10" Foreground="#9CA3AF"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 收起状态：只留一个展开按钮的窄条 -->
            <Button Grid.Row="1" Content="◀" Width="30" Height="80" Padding="0" FontSize="14"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}"
                    Command="{Binding ToggleExpandedCommand}"
                    ToolTip="展开侧边栏" />
        </Grid>
    </Border>
</Window>
