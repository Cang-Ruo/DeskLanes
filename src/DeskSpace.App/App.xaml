<Application x:Class="DeskSpace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 轻玻璃主题：全应用统一的颜色 / 画刷 / 控件样式（见 Themes/GlassTheme.xaml） -->
                <ResourceDictionary Source="Themes/GlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
