<!-- 阶段 17：用户要「真的全屏 / 无边框全屏，不要看到窗口界面」。
     去掉系统标题栏与边框，由 BeginFullMode 最大化铺满屏幕；
     Esc 与顶部「⌄ 托盘」按钮负责退出，切模式按钮仍在内容区。 -->
<Window x:Class="DeskLanes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskLanes.App.ViewModels"
        xmlns:views="clr-namespace:DeskLanes.App.Views"
        Title="DeskLanes" Height="760" Width="1180" MinHeight="420" MinWidth="620"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown" Closing="OnClosing">
    <!-- 背景说明：普通窗口由 WindowBackdropService 应用 Win11 原生 DWM 背景材料
         （Acrylic → Mica），失败时服务会把 Background 还原为不透明玻璃底色 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 阶段 31：全屏工作空间的磁贴等比缩到 80%（悬浮窗 / 侧边栏保持原尺寸）。
             用 LayoutTransform，父容器会按缩放后的尺寸排版，图标也更锐利。 -->
        <Style TargetType="{x:Type views:ItemTile}">
            <Setter Property="TileScale" Value="0.8" />
        </Style>
        <!-- 布局视图解析：CurrentView 绑定到对应视图模型时渲染对应视图 -->
        <DataTemplate DataType="{x:Type vm:CategoryNavViewModel}">
            <views:CategoryNavView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FreePanelsViewModel}">
            <views:FreePanelsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14" TextElement.Foreground="{StaticResource BrushTextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：软件名 + 布局切换 + 添加 + 刷新。
             弱化存在感：标题从 19 降到 13、去掉粗体并改用次级文字色，
             按钮统一收窄内边距并去掉实心底，让视觉重心落到下方内容区。 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DeskLanes" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource BrushTextSecondary}" />
                <TextBlock x:Name="SubtitleText"
                           Text="· 桌面工作空间"
                           FontSize="11" Foreground="{StaticResource BrushTextTertiary}" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="＋ 添加" Padding="9,4" Margin="0,0,6,0" FontSize="12"
                        ToolTip="通过文件选择器添加程序、快捷方式、文件夹或普通文件"
                        Command="{Binding AddCustomCommand}" />
                <Button Content="⇱ 悬浮" Padding="9,4" Margin="0,0,6,0" FontSize="12"
                        ToolTip="切换到悬浮窗快速启动（数据共用）"
                        Command="{Binding SwitchToFloatingCommand}" />
                <Button Content="▐ 侧栏" Padding="9,4" Margin="0,0,6,0" FontSize="12"
                        ToolTip="切换到侧边栏快捷入口（数据共用）"
                        Command="{Binding SwitchToSidebarCommand}" />
                <Button Content="{Binding LayoutToggleText}" Padding="9,4" Margin="0,0,6,0" FontSize="12"
                        Command="{Binding ToggleLayoutCommand}" />
                <Button Content="⟳ 刷新" Padding="9,4" Margin="0,0,6,0" FontSize="12"
                        Command="{Binding RefreshCommand}" />
                <Button Content="⌄ 托盘" Padding="9,4" FontSize="12"
                        ToolTip="最小化到系统托盘（应用继续运行，可从托盘退出）"
                        Click="OnMinimizeToTray" />
            </StackPanel>
        </Grid>

        <!-- 搜索框：贴近内容宽度，不再横跨整个窗口 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="10,7"
                     Width="420" MaxWidth="420" HorizontalAlignment="Left" />
            <TextBlock Text="搜索桌面项目（不区分大小写，切换布局不丢失）…"
                       Foreground="{StaticResource BrushTextTertiary}" FontSize="13"
                       Margin="15,0,0,0" VerticalAlignment="Center"
                     IsHitTestVisible="False"
                       Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 扫描/配置警告条 -->
        <Border Grid.Row="2" Style="{StaticResource WarningBar}" Margin="0,0,0,10"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource BrushWarningText}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,28,0" />
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource BrushWarningText}" ToolTip="忽略此提示"
                        Command="{Binding DismissWarningCommand}" />
            </Grid>
        </Border>

        <!-- 内容区：布局视图（分类导航 / 自由分区） + 加载中 + 空状态 -->
        <Grid Grid.Row="3">
            <ContentControl Content="{Binding CurrentView}"
                            Visibility="{Binding IsNotLoading, Converter={StaticResource BoolToVis}}" />

            <!-- 加载状态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                <TextBlock Text="正在扫描桌面…" Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>

            <!-- 全局空状态（桌面完全为空且无搜索） -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EmptyStateText}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <!-- 状态栏：项目统计 + 自动同步状态 -->
        <Border Grid.Row="4" Style="{StaticResource StatusBarScrim}" Margin="0,10,0,0">
        <Grid>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextTertiary}"
                       FontSize="12" HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            <TextBlock Text="{Binding SyncStatusText}" FontSize="12"
                       Foreground="{StaticResource BrushTextTertiary}"
                       HorizontalAlignment="Right" ToolTip="{Binding SyncStatusDetail}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSyncWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushWarningText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        </Border>
    </Grid>
</Window>
