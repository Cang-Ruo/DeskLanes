<Window x:Class="DeskLanes.App.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DeskLanes.App.ViewModels"
        xmlns:local="clr-namespace:DeskLanes.App.Views"
        xmlns:dt="clr-namespace:DeskLanes.App.Services"
        Title="DeskLanes 侧边栏"
        Width="280" Height="760" MinWidth="44" MinHeight="240"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" KeyDown="OnWindowKeyDown"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <!-- 阶段 30：改回分层窗口（AllowsTransparency=True），并去掉 WindowChrome。
         原因：Win11 的 DWM 会在窗口失焦时把系统 Acrylic 降级成不透明纯色
         （阶段 29 在焦点变化时重下发材质也拦不住，用户实测仍变灰白）。
         分层窗口由 WPF 自己合成透明像素，DWM 不再有机会按焦点画底色，
         因此「有焦点 / 无焦点」两态必然一致。
         模糊由 WindowBackdropService 走 SetWindowCompositionAttribute 的
         窗口级 Acrylic 提供；该 API 不可用时，根 Border 的半透明玻璃底
         仍然保证透明（只是没有毛玻璃模糊）。 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 与主窗口 / 悬浮窗同一套材质：WindowChrome 非分层窗口 + DWM Acrylic。
         曾经是分层窗口（AllowsTransparency=True），用不了 DWM 材质，
         只能垫 90% 不透明的深色底 —— 三个窗口里就它一个不像玻璃。
         贴边停靠时用 DWMWA_WINDOW_CORNER_PREFERENCE=DoNotRound（见 code-behind），
         避免 DWM 把贴着屏幕边缘的那两个角切掉。 -->
    <!-- 与悬浮窗同理：paintWindowSurface=false 时 Window.Background 是透明的，
         基底 tint 必须由这个带停靠侧圆角的 Border 画一次，不能绑定回去。 -->
    <Border Background="{StaticResource BrushSidebarBaseGlass}"
            Padding="10"
            BorderBrush="{StaticResource BrushBorderGlass}">
        <!-- 圆角与边框方向随停靠侧自适应：左侧停靠圆左边、无右边框；右侧停靠镜像 -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12,0,0,12" />
                <Setter Property="BorderThickness" Value="1,1,0,1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDockedRight}" Value="True">
                        <Setter Property="CornerRadius" Value="0,12,12,0" />
                        <Setter Property="BorderThickness" Value="1,1,1,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- 非分层窗口在 Win11 上自带系统阴影；原来的 DropShadowEffect
             在分层窗口里才有意义，现在留着反而会在窗口矩形内画一圈脏边 -->

        <Grid TextElement.Foreground="{StaticResource BrushTextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部：展开/收起 + 停靠切换 + 模式 + 关闭
                 收起态窗口只有 MinWidth=44 的窄条，这一排放不下，整体隐藏；
                 展开由下方收起态的「◀」按钮负责（同一命令）。
                 阶段 28：StackPanel → WrapPanel，宽度收到 100 时按钮自动换行，
                 不再被右边缘截断遮挡（最上面的那栏跟着宽度一起调整）。 -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,8"
                       Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Button Content="{Binding ExpandToggleText}" Padding="8,4" Margin="0,0,4,4" FontSize="12"
                        ToolTip="展开 / 收起侧边栏"
                        Command="{Binding ToggleExpandedCommand}" />
                <Button Content="{Binding DockToggleText}" Padding="8,4" Margin="0,0,4,4" FontSize="12"
                        ToolTip="切换停靠到屏幕左侧或右侧"
                        Command="{Binding ToggleDockCommand}" />
                <Button Content="全屏" Padding="8,4" Margin="0,0,4,4" FontSize="12"
                        ToolTip="切换到全屏工作空间（数据共用）"
                        Command="{Binding ToggleFullModeCommand}" />
                <Button Content="悬浮" Padding="8,4" Margin="0,0,4,4" FontSize="12"
                        ToolTip="切换到悬浮窗（数据共用）"
                        Command="{Binding ToggleFloatingModeCommand}" />
                <Button Content="✕" Width="26" Height="24" Padding="0" Background="Transparent"
                        BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}"
                        ToolTip="隐藏侧边栏（不退出应用）"
                        Command="{Binding HideWindowCommand}" />
            </WrapPanel>

            <!-- 展开状态：分类 + 项目 -->
            <Grid Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- 阶段 28：分类与项目区之间的可拖动分隔条 -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="分类" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />

                <!-- 阶段 28：MaxHeight 由 CategoryHeight 驱动（默认 150，可拖 60–420），
                     分类多时拉高分隔条就能看全，不再把底部的分类裁掉一半。 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0"
                         MaxHeight="{Binding CategoryHeight}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,0,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 阶段 27：三列布局，名称列吃掉剩余宽度并可截断，
                                 计数固定占右侧，长分类名不会再压到数字上。 -->
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="24" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BrushLabelScrim}"
                                        CornerRadius="3" Padding="4,1" HorizontalAlignment="Left"
                                        MaxWidth="150">
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BrushLabelScrim}"
                                        CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ItemCount}" FontSize="10"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 阶段 28：拖动调节「分类」区高度（上下箭头样式，悬停高亮） -->
                <Thumb Grid.Row="2" Height="8" Margin="0,0,0,4" Cursor="SizeNS"
                       DragDelta="OnCategoryHeightDragDelta"
                       DragCompleted="OnCategoryHeightDragCompleted"
                       ToolTip="拖动调节分类区高度">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" CornerRadius="2">
                                <Rectangle x:Name="GripLine" Height="2" RadiusX="1" RadiusY="1"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Fill="{StaticResource BrushBorderGlass}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripLine" Property="Height" Value="3" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="GripLine" Property="Height" Value="3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- 阶段 21：软件在上、文件夹在下，各自 A-Z -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnOuterPreviewMouseWheel"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Visibility="{Binding HasSoftwareItems, Converter={StaticResource BoolToVis}}">
                            <Border Background="{StaticResource BrushLabelScrim}" CornerRadius="3"
                                    Padding="6,2" Margin="2,0,0,6" HorizontalAlignment="Left">
                                <TextBlock Text="软件" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                            <ListBox ItemsSource="{Binding SoftwareItems}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" CornerRadius="6" ToolTip="{Binding TooltipText}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" />
                                                <Border Background="{StaticResource BrushLabelScrim}" CornerRadius="3"
                                                        Padding="3,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                   ToolTip="{Binding TooltipText}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasFolderItems, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0">
                            <Border Background="{StaticResource BrushLabelScrim}" CornerRadius="3"
                                    Padding="6,2" Margin="2,0,0,6" HorizontalAlignment="Left">
                                <TextBlock Text="文件夹" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                            <ListBox ItemsSource="{Binding FolderItems}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" CornerRadius="6" ToolTip="{Binding TooltipText}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" />
                                                <Border Background="{StaticResource BrushLabelScrim}" CornerRadius="3"
                                                        Padding="3,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                   ToolTip="{Binding TooltipText}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Text="{Binding EmptyStateText}" FontSize="12"
                           Foreground="{StaticResource BrushTextTertiary}" dt:DynamicText.Tone="Tertiary"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />

                <Border Grid.Row="4" Style="{StaticResource StatusBarScrim}" dt:DynamicText.Scrim="True"
                        HorizontalAlignment="Left"
                    Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                               Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <!-- 收起状态：只留一个展开按钮的窄条 -->
            <Button Grid.Row="1" Content="◀" Width="30" Height="80" Padding="0" FontSize="14"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}"
                    Command="{Binding ToggleExpandedCommand}"
                    ToolTip="展开侧边栏" />
        </Grid>
    </Border>
</Window>
