<Window x:Class="DeskLanes.App.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskLanes.App.ViewModels"
        xmlns:local="clr-namespace:DeskLanes.App.Views"
        Title="DeskLanes 快速启动"
        Width="780" Height="540" MinWidth="420" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown">
    <!-- 分层窗口（AllowsTransparency=True）无法使用 DWM 系统背景材料，
         按规格回退为高不透明度玻璃底色：文字与图标保持全不透明（见 GlassTheme.xaml） -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="{StaticResource BrushFloatingGlass}" CornerRadius="12" Padding="14"
            BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#101820" />
        </Border.Effect>

        <Grid TextElement.Foreground="{StaticResource BrushTextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：搜索框 + 模式切换 + 关闭 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Padding="12,10"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="搜索桌面项目（不区分大小写）…"
                           Foreground="{StaticResource BrushTextTertiary}" FontSize="14" Margin="17,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="全屏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="切换到全屏工作空间（数据共用）"
                            Command="{Binding ToggleFullModeCommand}" />
                    <Button Content="侧边栏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="切换到侧边栏模式（数据共用）"
                            Command="{Binding ToggleSidebarModeCommand}" />
                    <Button Content="✕" Width="28" Height="24" Padding="0" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}" ToolTip="隐藏窗口（Esc）"
                            Command="{Binding HideWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 分类标签 -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,10">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14"
                                            BorderBrush="Transparent" BorderThickness="1" Padding="12,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHoverGlass}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelectedGlass}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushFocusBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="{StaticResource BrushTextTertiary}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 项目网格：双击 / 回车启动 -->
            <ListBox Grid.Row="2"
                     x:Name="ItemList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:ItemTile />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding OpenItemCommand}"
                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <KeyBinding Key="Enter"
                                Command="{Binding OpenItemCommand}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
            </ListBox>

            <!-- 空状态 -->
            <TextBlock Grid.Row="2" Text="{Binding EmptyStateText}" FontSize="13"
                       Foreground="{StaticResource BrushTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />

            <!-- 底部状态栏 -->
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource BrushTextTertiary}"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />

            <!-- ============ 拖动 / 缩放热区 ============ -->
            <!-- 悬浮窗是分层窗口（WindowStyle=None + AllowsTransparency=True），系统不给标题栏
                 也不给缩放边框，拖动和缩放只能自己做热区。两个热区都用负 Margin 落进 Border 的
                 14px Padding 里：不压住任何控件，本身透明，不引入新的视觉元素。 -->

            <!-- 顶部拖动条：按住即可拖动；DragMove 由系统驱动，可跨显示器移动 -->
            <Rectangle x:Name="DragBar" Height="16" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       Margin="-14,-14,-14,0" Fill="Transparent" Cursor="SizeAll"
                       MouseLeftButtonDown="OnDragBarMouseLeftButtonDown" />

            <!-- 右下角缩放手柄：与自由分区面板同款的两道斜线 -->
            <Thumb x:Name="ResizeGrip" Grid.RowSpan="4"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="17" Height="17" Margin="0,0,-14,-14"
                   Cursor="SizeNWSE"
                   DragDelta="OnResizeGripDragDelta"
                   DragCompleted="OnResizeGripDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M 14 2 L 2 14 M 14 8 L 8 14 M 14 14 L 14 14"
                                  Stroke="#59FFFFFF" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,5,5" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
