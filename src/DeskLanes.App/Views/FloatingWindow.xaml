<Window x:Class="DeskLanes.App.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DeskLanes.App.ViewModels"
        xmlns:local="clr-namespace:DeskLanes.App.Views"
        xmlns:dt="clr-namespace:DeskLanes.App.Services"
        Title="DeskLanes 快速启动"
        Width="780" Height="540" MinWidth="420" MinHeight="360"
        WindowStyle="None" Background="Transparent"
        Topmost="False" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown">
    <!--
      曾经是分层窗口（AllowsTransparency=True），代价是用不了 DWM 的
      Acrylic / Mica 材质，只能垫一块 90% 不透明的深色底——和主窗口的
      玻璃感完全对不上。现在改为 WindowChrome 非分层窗口：
        - CaptionHeight=0 / ResizeBorderThickness=0：系统不接管标题栏与边缘，
          拖动与八方向缩放仍由自己的热区负责（行为与原来完全一致）
        - 背景材质由 WindowBackdropService 在 SourceInitialized 后应用
      根 Border 自己画那一层 18% 基底（带圆角），窗口表面留空：
      WindowBackdropService 以 paintWindowSurface=false 把 Window.Background 置为透明，
      若这里再绑定 Window.Background，这层 tint 就一层都画不上（阶段 2 的遗留缺陷，
      也是悬浮窗对比度一直是三个窗口里最差的原因）。
      材质不可用回退时窗口自身是深色不透明底，Border 只是在它上面再压 18%，仍然可读。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 缩放用的隐形热区：透明、不抢焦点，只靠 Cursor 提示可拖方向 -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushWindowBaseGlass}"
            CornerRadius="12" Padding="14"
            BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1">
        <!-- 非分层窗口在 Win11 上自带 DWM 系统阴影，原来的 DropShadowEffect 已无必要，
             且它在窗口矩形外不渲染，留着只会误导 -->

        <Grid TextElement.Foreground="{StaticResource BrushTextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：搜索框 + 模式切换 + 关闭 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Padding="12,10"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="搜索桌面项目（不区分大小写）…"
                           Foreground="{StaticResource BrushTextPrimary}" FontSize="14" Margin="17,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 阶段 19：两种展示方式切换 + 从打开的文件夹返回 -->
                    <Button Content="{Binding ViewModeButtonText}" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="在「全部（A-Z）」与「文件夹分组」之间切换"
                            Command="{Binding ToggleViewModeCommand}" />
                    <Button Content="← 返回" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="返回文件夹列表"
                            Visibility="{Binding IsOpenedFolderVisible, Converter={StaticResource BoolToVis}}"
                            Command="{Binding BackToFoldersCommand}" />
                    <Button Content="全屏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="切换到全屏工作空间（数据共用）"
                            Command="{Binding ToggleFullModeCommand}" />
                    <Button Content="侧边栏" Padding="10,5" Margin="0,0,6,0" FontSize="12"
                            ToolTip="切换到侧边栏模式（数据共用）"
                            Command="{Binding ToggleSidebarModeCommand}" />
                    <Button Content="✕" Width="28" Height="24" Padding="0" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}" ToolTip="隐藏窗口（Esc）"
                            Command="{Binding HideWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 分类标签 -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     Visibility="{Binding IsAllView, Converter={StaticResource BoolToVis}}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,10">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14"
                                            BorderBrush="Transparent" BorderThickness="1" Padding="12,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHoverGlass}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelectedGlass}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushFocusBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BrushLabelScrim}" dt:DynamicText.Scrim="True"
                                    CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                            </Border>
                            <!-- 中间灰玻璃上深浅两色都到不了 4.5，必须和名字一样垫局部底，
                                 且底与字成对切换（阶段 13 全文字块审计）。 -->
                            <Border Background="{StaticResource BrushLabelScrim}" dt:DynamicText.Scrim="True"
                                    CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ItemCount}" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 阶段 19：项目区分三种呈现，按视图模式切换 -->
            <Grid Grid.Row="2">
                <!-- ① 全部视图：文件夹 / 软件两区，各自 A-Z -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsAllView, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Visibility="{Binding HasDesktopFolderItems, Converter={StaticResource BoolToVis}}">
                            <Border Margin="2,2,0,6" Padding="7,3" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushLabelScrim}" CornerRadius="3">
                                <TextBlock Text="文件夹" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                            <ListBox ItemsSource="{Binding DesktopFolderItems}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><local:ItemTile /></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasSoftwareItems, Converter={StaticResource BoolToVis}}">
                            <Border Margin="2,10,0,6" Padding="7,3" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushLabelScrim}" CornerRadius="3">
                                <TextBlock Text="软件" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                            <ListBox ItemsSource="{Binding SoftwareItems}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><local:ItemTile /></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ② 文件夹视图：每个分组一个带边框的框，框里直接列出软件 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsGroupCardsVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <ItemsControl ItemsSource="{Binding GroupCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1"
                                            Background="{StaticResource BrushCardGlass}" CornerRadius="10"
                                            Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel Orientation="Vertical">
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 个项目}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><local:ItemTile /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="还没有分组。在分类导航里新建后，这里会自动出现。"
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="2,8,0,0"
                                   Visibility="{Binding HasNoGroupCards, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ③ 点开某个文件夹：列出里面的项目 -->
                <StackPanel Orientation="Vertical"
                            Visibility="{Binding IsOpenedFolderVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding OpenedFolderTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="2,2,0,8" />
                    <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><local:ItemTile /></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenItemCommand}"
                                        CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </ListBox.InputBindings>
                    </ListBox>
                </StackPanel>

                <!-- 空状态：卡片视图不显示 -->
                <TextBlock Text="{Binding EmptyStateText}" FontSize="13"
                           Foreground="{StaticResource BrushTextTertiary}" dt:DynamicText.Tone="Tertiary"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 底部状态栏：主窗口早就有 StatusBarScrim，这里补齐一致性 -->
            <Border Grid.Row="3" Style="{StaticResource StatusBarScrim}" dt:DynamicText.Scrim="True"
                    HorizontalAlignment="Left"
                    Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- ============ 拖动 / 缩放热区 ============ -->
            <!-- 悬浮窗是分层窗口（WindowStyle=None + AllowsTransparency=True），系统不给标题栏
                 也不给缩放边框，拖动和八方向缩放只能自己做热区。
                 所有热区都用负 Margin 落进 Border 的 14px Padding 里边，本身透明，
                 不引入新的视觉元素（唯一可见的是右下角那两道斜线）。
                 坐标口径：内容区左上角 = 窗口 (14,14)，所以「窗口 y=6」写成 Margin.Top = -8。 -->

            <!-- 上边：只能拉高（0~5 DIP）。
                 顶部这一条被上边热区和拖动条分掉：最上 5 DIP 拉高，往下 17 DIP 拖动。
                 两个热区的分界线离得越远越好，否则一次点击可能因为像素舍入落在另一边。 -->
            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="T"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Height="5" Margin="2,-14,2,0" Cursor="SizeNS"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <!-- 顶部拖动条：按住即可移动；DragMove 由系统驱动，可跨显示器移动 -->
            <Rectangle x:Name="DragBar" Height="17" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       Margin="2,-9,2,0" Fill="Transparent" Cursor="SizeAll"
                       MouseLeftButtonDown="OnDragBarMouseLeftButtonDown" />

            <!-- 下边：只能拉高 -->
            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="B"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Height="6" Margin="16,0,16,-14" Cursor="SizeNS"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <!-- 左边：只能拉宽 -->
            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="L"
                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Width="6" Margin="-14,16,0,16" Cursor="SizeWE"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <!-- 右边：只能拉宽 -->
            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="R"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Width="6" Margin="0,16,-14,16" Cursor="SizeWE"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <!-- 四角：同时拉宽与拉高 -->
            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="TL"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Width="16" Height="16" Margin="-14,-14,0,0" Cursor="SizeNWSE"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="TR"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Width="16" Height="16" Margin="0,-14,-14,0" Cursor="SizeNESW"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <Thumb Grid.RowSpan="4" Style="{StaticResource ResizeThumbStyle}" Tag="BL"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Width="16" Height="16" Margin="-14,0,0,-14" Cursor="SizeNESW"
                   DragDelta="OnResizeDragDelta" DragCompleted="OnResizeDragCompleted" />

            <!-- 右下角：唯一有可见标记的手柄（与自由分区面板同款的两道斜线） -->
            <Thumb Grid.RowSpan="4" Tag="BR"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="17" Height="17" Margin="0,0,-14,-14"
                   Cursor="SizeNWSE"
                   DragDelta="OnResizeDragDelta"
                   DragCompleted="OnResizeDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M 14 2 L 2 14 M 14 8 L 8 14 M 14 14 L 14 14"
                                  Stroke="#59FFFFFF" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,5,5" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
