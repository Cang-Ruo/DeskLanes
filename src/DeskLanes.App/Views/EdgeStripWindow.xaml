<Window x:Class="DeskLanes.App.Views.EdgeStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLanes 边缘细线"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Width="19" Height="900" Cursor="Hand"
        ToolTip="展开 DeskLanes">
    <!-- 阶段 34：一个窗口承载三种收束指示器。
         · 侧边栏：0.5cm 半透明边栏，常驻可见，悬停展开
         · 全屏  ：热区常驻但可见窄条默认隐藏，鼠标靠近左边界才弹出，点击展开
         · 悬浮窗：直径 3cm 半透明小球，贴在左边缘中部，点击展开
         Root 的 alpha≠0 保证分层窗口下鼠标不会穿透。 -->
    <Grid x:Name="Root" Background="#01000000"
          MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseUp">
        <Border x:Name="Bar" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                CornerRadius="0,3,3,0" />
    <!-- 阶段 37：小球 A「细环玻璃球」——本体同款半透明玻璃 + 1px 冷蓝细环 +
         中心小菱形；悬停加粗细环并浮出淡光环；拖动时细环变虚线、中心收成方块。
         主体玻璃 / 细环都留 4px 内边距，光环才能完整落在 3cm 窗口里不被裁掉。 -->
    <Grid x:Name="BallGroup" HorizontalAlignment="Center" VerticalAlignment="Center"
          Visibility="Collapsed">
        <Ellipse x:Name="BallHalo" Margin="0" Stretch="Fill" StrokeThickness="0.5"
                 Visibility="Collapsed" />
        <Ellipse x:Name="BallGlass" Margin="4" Stretch="Fill" />
        <Ellipse x:Name="BallRing" Margin="4" Stretch="Fill" StrokeThickness="1" />
        <Path x:Name="CoreIdle" Data="M 6 0 L 12 6 L 6 12 L 0 6 Z"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Path x:Name="CoreHover" Data="M 9 0 L 18 9 L 9 18 L 0 9 Z"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" />
        <Rectangle x:Name="CoreDrag" Width="8" Height="8"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
    </Grid>
</Window>
