<Window x:Class="DeskLanes.App.Views.EdgeStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLanes 边缘细线"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Width="8" Height="900" Cursor="Hand"
        ToolTip="悬停 / 点击展开 DeskLanes">
    <!-- 阶段 31：收束后只留左侧一条不明显竖线。
         外层 8 DIP 是鼠标命中区，实际可见的只有 2 DIP 的淡线；
         alpha≠0 保证分层窗口下鼠标不会穿透。 -->
    <Grid x:Name="Root" Background="#01000000"
          MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          MouseLeftButtonUp="OnClick">
        <Border x:Name="Line" Width="2" HorizontalAlignment="Left"
                VerticalAlignment="Stretch" CornerRadius="1"
                Background="#26E8F1FF" />
    </Grid>
</Window>
