<Window x:Class="DeskLanes.App.Views.EdgeStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLanes 边缘细线"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Width="76" Height="76" Cursor="Hand">
    <!-- 一个窗口承载三种收束指示器：侧栏边栏 / 全屏窄条 / 悬浮窗珍珠冰晶球。
         Root 的 alpha≠0 保证分层窗口下鼠标不会穿透。 -->
    <Window.Resources>
        <!-- 阶段 40：色值本身带低 Alpha（#AARRGGBB），元素 Opacity 保持 1，
             避免「不透明色 × 元素透明度」双重衰减把中心做成实心蓝珠。
             中心 8~13%、边缘 22~29%，桌面能透过球体。 -->
        <RadialGradientBrush x:Key="OrbBodyIdleBrush" GradientOrigin="0.34,0.24"
                             Center="0.46,0.44" RadiusX="0.78" RadiusY="0.78">
            <GradientStop Color="#35F5FBFF" Offset="0" />
            <GradientStop Color="#18D9EEFF" Offset="0.42" />
            <GradientStop Color="#269CC8EB" Offset="0.78" />
            <GradientStop Color="#38B7AFE9" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbBodyHoverBrush" GradientOrigin="0.34,0.24"
                             Center="0.46,0.44" RadiusX="0.78" RadiusY="0.78">
            <GradientStop Color="#42F5FBFF" Offset="0" />
            <GradientStop Color="#20D9EEFF" Offset="0.42" />
            <GradientStop Color="#309CC8EB" Offset="0.78" />
            <GradientStop Color="#44B7AFE9" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbBodyDragBrush" GradientOrigin="0.34,0.24"
                             Center="0.46,0.44" RadiusX="0.78" RadiusY="0.78">
            <GradientStop Color="#4AF5FBFF" Offset="0" />
            <GradientStop Color="#26D9EEFF" Offset="0.42" />
            <GradientStop Color="#389CC8EB" Offset="0.78" />
            <GradientStop Color="#4CB7AFE9" Offset="1" />
        </RadialGradientBrush>

        <!-- 内部流动光影：同样带低 Alpha，避免叠加成实心 -->
        <LinearGradientBrush x:Key="OrbFlowCyanBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2AB6F2EC" Offset="0" />
            <GradientStop Color="#1E8FD8F2" Offset="0.55" />
            <GradientStop Color="#28B7BBF0" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrbFlowPearlBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#2AFFFFFF" Offset="0" />
            <GradientStop Color="#1ADCEEFF" Offset="0.5" />
            <GradientStop Color="#2AFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrbFlowLavenderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#28C9B9F2" Offset="0" />
            <GradientStop Color="#30E3CFF8" Offset="0.5" />
            <GradientStop Color="#1E9FB6E8" Offset="1" />
        </LinearGradientBrush>

        <!-- 边缘虹彩：集中在边缘，不做满球彩虹 -->
        <LinearGradientBrush x:Key="OrbIrisBrush" StartPoint="0,0.2" EndPoint="1,0.85">
            <GradientStop Color="#4A7FDED8" Offset="0" />
            <GradientStop Color="#3AD8F2FF" Offset="0.28" />
            <GradientStop Color="#66FFFFFF" Offset="0.5" />
            <GradientStop Color="#48C3B2F0" Offset="0.76" />
            <GradientStop Color="#52E6C9F7" Offset="1" />
        </LinearGradientBrush>
        <!-- 波浪：两端淡出的渐变描边，像悬浮在玻璃内部 -->
        <LinearGradientBrush x:Key="OrbWaveMainBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#00F1FAFF" Offset="0" />
            <GradientStop Color="#6EF5FBFF" Offset="0.22" />
            <GradientStop Color="#CFFFFFFF" Offset="0.52" />
            <GradientStop Color="#6EF1FAFF" Offset="0.8" />
            <GradientStop Color="#00F1FAFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrbWaveSubBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#009FD8F5" Offset="0" />
            <GradientStop Color="#5EBDE6FF" Offset="0.22" />
            <GradientStop Color="#A8D8F5FF" Offset="0.52" />
            <GradientStop Color="#5ECAEAFF" Offset="0.8" />
            <GradientStop Color="#009FD8F5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrbTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#C4FFFFFF" Offset="0.4" />
            <GradientStop Color="#E6FFFFFF" Offset="0.62" />
            <GradientStop Color="#00DCEBFF" Offset="1" />
        </LinearGradientBrush>
        <!-- 局部虹彩：左下青绿 / 右侧淡紫 / 底部粉蓝 -->
        <LinearGradientBrush x:Key="OrbIrisLeftBrush" StartPoint="0,1" EndPoint="0.6,0">
            <GradientStop Color="#007FDED8" Offset="0" />
            <GradientStop Color="#5A8FE8DC" Offset="0.55" />
            <GradientStop Color="#00B6F2EC" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrbIrisRightBrush" StartPoint="0.2,0" EndPoint="1,1">
            <GradientStop Color="#00B6F2EC" Offset="0" />
            <GradientStop Color="#5AC3B2F0" Offset="0.5" />
            <GradientStop Color="#00E6C9F7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrbIrisBottomBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00C3B2F0" Offset="0" />
            <GradientStop Color="#4AC8B6F5" Offset="0.6" />
            <GradientStop Color="#00B7AFE9" Offset="1" />
        </LinearGradientBrush>

        <!-- 阶段 42：Crystal Aura 冰晶柔光。
             外缘 alpha=0 正好落在 56 DIP 窗口边界，既没有第二道圆边、也不会被裁切；
             峰值放在球体边缘（offset≈0.79）附近，向内向外都柔和衰减。 -->
        <RadialGradientBrush x:Key="OrbAuraIdleBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#00BDEEFF" Offset="0" />
            <GradientStop Color="#00BDEEFF" Offset="0.30" />
            <GradientStop Color="#03BDEEFF" Offset="0.46" />
            <GradientStop Color="#0ABDEEFF" Offset="0.58" />
            <GradientStop Color="#04BDEEFF" Offset="0.80" />
            <GradientStop Color="#00BDEEFF" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbAuraHoverBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#00BDEEFF" Offset="0" />
            <GradientStop Color="#00BDEEFF" Offset="0.30" />
            <GradientStop Color="#11BDEEFF" Offset="0.46" />
            <GradientStop Color="#36BDEEFF" Offset="0.58" />
            <GradientStop Color="#16BDEEFF" Offset="0.80" />
            <GradientStop Color="#00BDEEFF" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbAuraDragBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#00A8EEF0" Offset="0" />
            <GradientStop Color="#00A8EEF0" Offset="0.30" />
            <GradientStop Color="#1AA8EEF0" Offset="0.46" />
            <GradientStop Color="#4FA8EEF0" Offset="0.58" />
            <GradientStop Color="#20A8EEF0" Offset="0.80" />
            <GradientStop Color="#00A8EEF0" Offset="1" />
        </RadialGradientBrush>

        <!-- 浅色冰晶 Tooltip，只在此窗口生效 -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#2A4A6B" />
            <Setter Property="Background" Value="#F0E6F2FF" />
            <Setter Property="BorderBrush" Value="#B4CDE8" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#01000000"
          ToolTipService.InitialShowDelay="550"
          MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseUp" LostMouseCapture="OnLostMouseCapture">
        <Border x:Name="Bar" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                CornerRadius="0,3,3,0" />

        <!-- 阶段 40：珍珠冰晶球，44 DIP 可视 / 56 DIP 热区；统一圆形裁切，球外透明 -->
        <Grid x:Name="OrbGroup" Width="44" Height="44"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- 阶段 42：Crystal Aura —— 从球体向外散开的柔光，无独立描边圆环。
                 Margin=-6 让渐变层正好铺满 56 DIP 窗口，外缘 alpha=0 不与窗口边界重合。 -->
            <Ellipse x:Name="OrbAuraIdle" Margin="-16" Fill="{StaticResource OrbAuraIdleBrush}"
                     IsHitTestVisible="False" />
            <Ellipse x:Name="OrbAuraHover" Margin="-16" Fill="{StaticResource OrbAuraHoverBrush}"
                     Opacity="0" IsHitTestVisible="False" />
            <Ellipse x:Name="OrbAuraDrag" Margin="-16" Fill="{StaticResource OrbAuraDragBrush}"
                     Opacity="0" IsHitTestVisible="False" />

            <!-- 浅色环境阴影托住球体 -->
            <Ellipse x:Name="OrbShadow" Margin="-3" Fill="#6B7DB8" Opacity="0.24">
                <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
            </Ellipse>

            <Grid>
                <Grid.Clip>
                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                </Grid.Clip>

                <!-- 1. 低 Alpha 主体：桌面能透出 -->
                <Ellipse x:Name="OrbGlassIdle" Fill="{StaticResource OrbBodyIdleBrush}" />
                <Ellipse x:Name="OrbGlassHover" Fill="{StaticResource OrbBodyHoverBrush}" Visibility="Collapsed" />
                <Ellipse x:Name="OrbGlassDrag" Fill="{StaticResource OrbBodyDragBrush}" Visibility="Collapsed" />

                <!-- 2. 极淡的内部流动光影（几不可察，只提供层次） -->
                <Path x:Name="OrbFlowPearl" Data="M2,13 C10,5 24,7 42,11 C30,16 16,13 2,20 Z"
                      Fill="{StaticResource OrbFlowPearlBrush}" Opacity="0.5">
                    <Path.Effect><BlurEffect Radius="2.5" /></Path.Effect>
                </Path>
                <Path x:Name="OrbFlowCyan" Data="M0,29 C10,20 20,32 30,25 C36,21 41,25 44,23 L44,44 L0,44 Z"
                      Fill="{StaticResource OrbFlowCyanBrush}" Opacity="0.45">
                    <Path.Effect><BlurEffect Radius="3" /></Path.Effect>
                </Path>
                <Path x:Name="OrbFlowLavender" Data="M12,44 C20,33 30,41 44,27 L44,44 Z"
                      Fill="{StaticResource OrbFlowLavenderBrush}" Opacity="0.48">
                    <Path.Effect><BlurEffect Radius="3" /></Path.Effect>
                </Path>

                <!-- 3. 玻璃边缘：外轮廓（细珍珠白）+ 内折射（淡冰蓝）+ 局部虹彩 -->
                <Ellipse x:Name="OrbRimOuter" Margin="0.4" Stroke="#DCEEFF"
                         StrokeThickness="0.9" Opacity="0.88" />
                <Ellipse x:Name="OrbRimInner" Margin="2.2" Stroke="#BDE6FF"
                         StrokeThickness="1.2" Opacity="0.4">
                    <Ellipse.Effect><BlurEffect Radius="1.2" /></Ellipse.Effect>
                </Ellipse>
                <Path x:Name="OrbIrisLeft" Data="M5,25 A17,17 0 0 0 13,38"
                      Stroke="{StaticResource OrbIrisLeftBrush}" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="2" /></Path.Effect>
                </Path>
                <Path x:Name="OrbIrisRight" Data="M36,13 A17,17 0 0 1 39,31"
                      Stroke="{StaticResource OrbIrisRightBrush}" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="2" /></Path.Effect>
                </Path>
                <Path x:Name="OrbIrisBottom" Data="M13,39 A17,17 0 0 0 33,38"
                      Stroke="{StaticResource OrbIrisBottomBrush}" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="2" /></Path.Effect>
                </Path>

                <!-- 4. 两条波浪光带：柔光底 + 两端淡出的清晰主体 -->
                <Path x:Name="OrbWaveMainGlow"
                      Data="M6,31 C13,30 16,22 23,21 C30,20 33,13 39,9"
                      Stroke="{StaticResource OrbWaveMainBrush}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.28">
                    <Path.Effect><BlurEffect Radius="2" /></Path.Effect>
                </Path>
                <Path x:Name="OrbWaveSubGlow"
                      Data="M5,37 C13,35 17,28 24,27 C31,26 35,19 40,15"
                      Stroke="{StaticResource OrbWaveSubBrush}" StrokeThickness="4.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.26">
                    <Path.Effect><BlurEffect Radius="2" /></Path.Effect>
                </Path>
                <Path x:Name="OrbWaveMain"
                      Data="M6,31 C13,30 16,22 23,21 C30,20 33,13 39,9"
                      Stroke="{StaticResource OrbWaveMainBrush}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="OrbWaveSub"
                      Data="M5,37 C13,35 17,28 24,27 C31,26 35,19 40,15"
                      Stroke="{StaticResource OrbWaveSubBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- 5. 左上珍珠白高光 -->
                <Path x:Name="OrbTopHighlight" Data="M8,13 A16,16 0 0 1 31,8"
                      Stroke="{StaticResource OrbTopHighlightBrush}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="1" /></Path.Effect>
                </Path>
            </Grid>
        </Grid>
    </Grid>
</Window>
