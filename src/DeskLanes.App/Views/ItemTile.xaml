<UserControl x:Class="DeskLanes.App.Views.ItemTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dt="clr-namespace:DeskLanes.App.Services"
             Width="112" Height="110">
    <!-- 项目磁贴：图标是视觉焦点（规格 4.4）；悬停只做轻微提亮，不做厚重卡片 -->
    <UserControl.Resources>
        <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushHoverGlass}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border x:Name="TileBorder" CornerRadius="8" Padding="6,6"
            ToolTip="{Binding TooltipText}">
        <StackPanel>
            <Image Source="{Binding Icon}" Width="48" Height="48"
                   Margin="0,2,0,6" RenderOptions.BitmapScalingMode="HighQuality" />
            <!-- 阶段 16：用户觉得深黑名字条丑，改成固定浅灰底 + 深灰黑字。
                 不挂 dt:DynamicText.Scrim —— 这一块要恒定浅灰，不随壁纸切换。 -->
            <Border Background="{StaticResource BrushNamePlate}"
                    CornerRadius="4" Padding="4,1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}" MaxWidth="100"
                           Style="{StaticResource ItemNameTextOnLight}" />
            </Border>
            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource BrushDangerText}"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
