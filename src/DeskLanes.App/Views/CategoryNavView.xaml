<UserControl x:Class="DeskLanes.App.Views.CategoryNavView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeskLanes.App.Views"
             xmlns:dt="clr-namespace:DeskLanes.App.Services">
    <UserControl.Resources>
        <local:BindingProxy x:Key="VM" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：分类导航（半透明玻璃，与内容区柔和分层） -->
        <Border Grid.Column="0" Style="{StaticResource GlassNavPanel}" Margin="0,0,10,0">
            <DockPanel>
                <TextBlock Text="分类" Style="{StaticResource SectionTitle}"
                           DockPanel.Dock="Top" Margin="2,0,0,8" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="新建" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                            Command="{Binding NewCategoryCommand}" />
                    <Button Content="重命名" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                            Command="{Binding RenameCategoryCommand}" />
                    <Button Content="删除" Padding="10,4" FontSize="12"
                            Command="{Binding DeleteCategoryCommand}" />
                </StackPanel>
                <!-- 提示放在列表之前停靠底部；列表作为最后子元素填充剩余空间 -->
                <TextBlock DockPanel.Dock="Bottom" Text="提示：把右侧项目拖到分类上即可加入；桌面文件不会被移动。"
                           Style="{StaticResource HintText}" Margin="2,8,0,0" />
                <ListBox x:Name="CategoryList"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         AllowDrop="True" Drop="OnCategoryDrop" DragOver="OnCategoryDragOver"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemNameTextTight}"
                                           dt:DynamicText.Tone="Primary" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ItemCount}" Foreground="{StaticResource BrushTextTertiary}"
                                           FontSize="11" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右：项目区。外面套一层玻璃面板：项目直接裸在壁纸上会和背后的
             模糊图标抢注意力，加这一层才有"导航 / 面板 / 卡片"三个层次的区分 -->
        <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="12,8,12,10">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具栏：排序 + 搜索提示 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="上移" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                        Command="{Binding MoveCategoryUpCommand}" />
                <Button Content="下移" Padding="10,4" Margin="0,0,12,0" FontSize="12"
                        Command="{Binding MoveCategoryDownCommand}" />
                <TextBlock Text="{Binding SearchHint}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSearchHint, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- 项目网格（选中/悬停反馈由主题的 ListBoxItem 隐式样式提供） -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Items}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="打开"
                                              Command="{Binding Data.OpenItemCommand, Source={StaticResource VM}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="从工作区移除"
                                              Command="{Binding Data.RemoveItemCommand, Source={StaticResource VM}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:ItemTile />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding Data.OpenItemCommand, Source={StaticResource VM}}"
                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <KeyBinding Key="Enter"
                                Command="{Binding Data.OpenItemCommand, Source={StaticResource VM}}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
            </ListBox>

            <!-- 空分类 / 无搜索结果 -->
            <TextBlock Grid.Row="1" Text="{Binding EmptyStateText}" FontSize="13"
                       Foreground="{StaticResource BrushTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                       Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />

            <!-- 移除区：只在拖拽项目时出现。
                 平时一条常驻的红色横条会不停抢视觉焦点，与「低存在感」冲突；
                 拖拽行为与安全规则本身完全不变。 -->
            <Border Grid.Row="2" Style="{StaticResource DangerZone}" Margin="0,8,0,0"
                    AllowDrop="True" Drop="OnRemoveDrop" DragOver="OnRemoveDragOver"
                    Visibility="{Binding IsDraggingItem, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="🗑 把项目拖到这里，从工作区移除（不会删除桌面文件）"
                           FontSize="12" Foreground="{StaticResource BrushDangerText}" HorizontalAlignment="Center" />
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
