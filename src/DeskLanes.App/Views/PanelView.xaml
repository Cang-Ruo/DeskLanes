<UserControl x:Class="DeskLanes.App.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeskLanes.App.Views"
             xmlns:dt="clr-namespace:DeskLanes.App.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <!-- 几何（Canvas.Left/Top/Width/Height）由外层 DataTemplate 绑定在 PanelView 元素上，
         Canvas 只识别直接子元素的附加属性；内部 Border 撑满 UserControl 即可 -->
    <!-- 阶段 19：拖放目标放在根 Border 上。原先只挂在项目 ListBox 上，
         而那个 ListBox 绑了 HasItems 可见性——空面板时控件被折叠，根本收不到 Drop，
         导致「下面的项目拖不进新建的分区」。 -->
    <Border x:Name="PanelBorder" BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1"
            Background="{StaticResource BrushCardGlass}" CornerRadius="10"
            AllowDrop="True" Drop="OnItemDrop" DragOver="OnItemDragOver"
            MouseLeftButtonDown="OnPanelMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：按住拖动移动面板，单击选中 -->
            <Thumb x:Name="MoveThumb" Grid.Row="0" Cursor="SizeAll"
                   DragDelta="OnMoveDragDelta" DragStarted="OnMoveDragStarted"
                   PreviewMouseLeftButtonDown="OnMoveThumbPreviewMouseLeftButtonDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#2E17283B" CornerRadius="9,9,0,0" Padding="10,9"
                                ToolTip="按住这里拖动整个分区；右下角可拉伸大小">
                            <Grid>
                                <TextBlock Text="⠿" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Margin="18,0,0,0"
                                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                <!-- 标题栏本身是固定深底 #2E17283B，用静态主文字色即可，
                                     不接入动态色（否则亮壁纸下会误判成深字压深底）。 -->
                                <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 项目区：拖放目标 -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Items}"
                     Background="Transparent" BorderThickness="0" Padding="6"
                     AllowDrop="True" Drop="OnItemDrop" DragOver="OnItemDragOver"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="打开"
                                              Command="{Binding OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="放回未分区池"
                                              Command="{Binding ReturnToPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="从工作区移除"
                                              Command="{Binding RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:ItemTile />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
            </ListBox>

            <!-- 空分区提示 -->
            <TextBlock Grid.Row="1" Text="把项目拖到这里" FontSize="12" Foreground="{StaticResource BrushTextTertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 阶段 21：像窗口一样，四条边 + 四个角都能拖动调整大小。
                 统一走 OnEdgeResizeDragDelta，用 Tag 区分方向；透明但可命中。 -->
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Width="7" Cursor="SizeWE" Tag="Left" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Width="7" Cursor="SizeWE" Tag="Right" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Height="7" Cursor="SizeNS" Tag="Top" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Height="7" Cursor="SizeNS" Tag="Bottom" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Width="14" Height="14" Cursor="SizeNWSE" Tag="TopLeft" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Width="14" Height="14" Cursor="SizeNESW" Tag="TopRight" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Width="14" Height="14" Cursor="SizeNESW" Tag="BottomLeft" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="16" Height="16" Cursor="SizeNWSE" Tag="BottomRight" DragDelta="OnEdgeResizeDragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M 14 2 L 2 14 M 14 8 L 8 14 M 14 14 L 14 14"
                                  Stroke="#59FFFFFF" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
