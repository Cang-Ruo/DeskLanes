<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      DeskLanes 轻玻璃主题（统一设计资源，规格 3.4 节）
      原则：
      1. 透明度只加在"背景画刷"上，文字与图标永远保持全不透明（规格 §3.2）。
      2. 分层透明度：窗口外层最透，内容面板稍实，卡片再稍实（规格 §3.2）。
      3. 蓝色只用于选中 / 焦点 / 交互反馈，不做大面积着色（规格 §3.1）。
      命名约定：Color* 为原始颜色，Brush* 为可直接使用的画刷。
    -->

    <!-- ============ 颜色（规格 §3.2 建议值为起点） ============ -->
    <Color x:Key="ColorTextPrimary">#F1F5FA</Color>
    <Color x:Key="ColorTextSecondary">#B7C6D8</Color>
    <Color x:Key="ColorTextTertiary">#8CA0B8</Color>
    <Color x:Key="ColorAccent">#70B5F5</Color>
    <Color x:Key="ColorPanel">#20334A</Color>
    <Color x:Key="ColorNav">#17283B</Color>
    <Color x:Key="ColorWarning">#FFCE8A</Color>
    <Color x:Key="ColorDanger">#FF9C8A</Color>

    <!-- ============ 文字画刷（全不透明） ============ -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushWarningText" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDangerText" Color="{StaticResource ColorDanger}" />

    <!-- ============ 玻璃画刷（分层透明度） ============ -->
    <!-- 侧边栏底色：仍是分层窗口（贴边窗口用 DWM 圆角会把贴边侧切成缺角，
         得不偿失），保持高不透明度保证任何壁纸下文字可读。
         悬浮窗已改为 WindowChrome 非分层窗口走真 Acrylic，不再用 BrushFloatingGlass。 -->
    <SolidColorBrush x:Key="BrushSidebarGlass" Color="#E61E2F46" />
    <SolidColorBrush x:Key="BrushFloatingGlass" Color="#E620334A" />
    <!-- 弹出层（菜单/提示）底色：近乎不透明 -->
    <SolidColorBrush x:Key="BrushMenuGlass" Color="#F21B2B3F" />
    <!-- 普通窗口在原生 DWM 背景之上的内容层次。
         下面这几层是叠在 Acrylic 之上的 tint：调太实会把玻璃感盖掉，
         目标是「透得出壁纸，又压得住文字对比度」，所以都压在 15%~35%。 -->
    <SolidColorBrush x:Key="BrushWindowBaseGlass" Color="#2E20334A" />
    <SolidColorBrush x:Key="BrushNavGlass" Color="#5917283B" />
    <SolidColorBrush x:Key="BrushPanelGlass" Color="#2420334A" />
    <SolidColorBrush x:Key="BrushCardGlass" Color="#3D20334A" />
    <!-- 输入控件底色 -->
    <SolidColorBrush x:Key="BrushInputGlass" Color="#14FFFFFF" />
    <!-- 交互反馈 -->
    <SolidColorBrush x:Key="BrushHoverGlass" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="BrushHoverStrongGlass" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BrushPressedGlass" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="BrushSelectedGlass" Color="#2E70B5F5" />
    <SolidColorBrush x:Key="BrushSelectedStrongGlass" Color="#4770B5F5" />
    <!-- 边框与分隔 -->
    <SolidColorBrush x:Key="BrushBorderGlass" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="BrushBorderStrongGlass" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="BrushFocusBorder" Color="#8070B5F5" />
    <SolidColorBrush x:Key="BrushSeparator" Color="#1AFFFFFF" />
    <!-- 选中文字块背景 -->
    <SolidColorBrush x:Key="BrushSelection" Color="#5570B5F5" />
    <!-- 语义色背景（警告条 / 移除区） -->
    <SolidColorBrush x:Key="BrushWarningGlass" Color="#2EF5C97B" />
    <SolidColorBrush x:Key="BrushWarningBorder" Color="#59F5C97B" />
    <SolidColorBrush x:Key="BrushDangerGlass" Color="#2EF97066" />
    <SolidColorBrush x:Key="BrushDangerBorder" Color="#59F97066" />
    <!-- 原生背景不可用时的窗口回退底色 -->
    <SolidColorBrush x:Key="BrushWindowFallback" Color="#FF1E3046" />

    <!-- ============ 按钮 ============ -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BrushInputGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHoverStrongGlass}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrongGlass}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPressedGlass}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushFocusBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 文本输入框 ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BrushInputGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushSelection}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrongGlass}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushFocusBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 列表项（悬停 / 选中 = 低透明度蓝） ============ -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHoverGlass}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelectedGlass}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelectedStrongGlass}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 复选框 ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{StaticResource BrushInputGlass}"
                                BorderBrush="{StaticResource BrushBorderStrongGlass}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3 8 L 6.5 11.5 L 13 4"
                                  Stroke="{StaticResource BrushAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushFocusBorder}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushHoverStrongGlass}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 单选项 ============ -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="{StaticResource BrushInputGlass}"
                                BorderBrush="{StaticResource BrushBorderStrongGlass}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{StaticResource BrushAccent}"
                                     Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource BrushFocusBorder}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource BrushHoverStrongGlass}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 进度条（加载状态） ============ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="Background" Value="{StaticResource BrushInputGlass}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 滚动条（细、低调） ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBg" Background="#2EFFFFFF"
                                                    CornerRadius="4" Margin="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background" Value="#47FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background" Value="#59FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBg" Background="#2EFFFFFF"
                                                            CornerRadius="4" Margin="1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBg" Property="Background" Value="#47FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBg" Property="Background" Value="#59FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 工具提示 ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BrushMenuGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrongGlass}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 右键菜单（无二级菜单需求，单层即可） ============ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource BrushMenuGlass}"
                            BorderBrush="{StaticResource BrushBorderStrongGlass}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,6">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelectedGlass}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 命名样式：面板 / 分区 / 提示条 ============ -->
    <!-- 导航区域：比内容更暗一层的玻璃 -->
    <Style x:Key="GlassNavPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushNavGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- 内容面板：比窗口背景稍实 -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanelGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- 卡片：自由分区面板等，再稍实一层 -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCardGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- 警告条 -->
    <Style x:Key="WarningBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushWarningGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushWarningBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- 移除区（危险操作投放区） -->
    <Style x:Key="DangerZone" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushDangerGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushDangerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- 项目池 / 通用投放区 -->
    <Style x:Key="DropZone" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanelGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- 文字层级 -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
