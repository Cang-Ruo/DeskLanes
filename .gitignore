bin/
obj/
publish/

# Visual Studio / Rider 用户文件
*.user
*.suo
*.userprefs
.vs/
.idea/

# 阶段 5 的截图证据（48MB 的可再生诊断材料，不入仓库）
docs/stage5-evidence/

# 测试与诊断产生的日志
*.log

# 阶段验收日志属于交付证据，单独放行（上面的 *.log 会排除它们）
!docs/stage*-verify.log

# 智能体工作目录（项目记忆，非源码）
.workbuddy/

# 阶段 7 的截图证据（33MB 的可再生诊断材料，不入仓库；关键小图用 git add -f 单独收）
docs/stage7-evidence/

# Python 字节码缓存（tools/*.py 编译产物）
__pycache__/
*.pyc

# 阶段验收的整屏原始帧：含真实桌面图标，不入仓库（本地留存用于复核）
docs/ui-acrylic-final/raw/

# 阶段 2 前后对照截图：含真实桌面项目名，只留本地
docs/ui-acrylic-final/phase2-*.png

# 阶段 3 的可读性整窗截图：含真实项目名，只留本地
docs/ui-acrylic-final/readability-*.png
# 测试壁纸由脚本生成，不入库
docs/ui-acrylic-final/wallpapers/

# 阶段 9 的清场 / tint 对照截图与整屏原始帧：含真实桌面项目名，只留本地；
# 指标统一收在 phase9-evidence.json 与 readability-phase9-*.json
docs/ui-acrylic-final/phase9-clean/
docs/ui-acrylic-final/phase9-tint26/
docs/ui-acrylic-final/phase9-tint29/
